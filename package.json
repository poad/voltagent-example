{
  "name": "voltagent-example",
  "version": "0.1.0",
  "description": "A VoltAgent application",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env ./src",
    "build": "tsdown",
    "start": "node dist/index.js",
    "lint": "biome check ./src",
    "lint-fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "volt": "volt"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.133",
    "@dotenvx/dotenvx": "^2.38.2",
    "@voltagent/cli": "^0.1.21",
    "@voltagent/core": "^2.11.1",
    "@voltagent/libsql": "^2.1.2",
    "@voltagent/logger": "^2.0.2",
    "@voltagent/server-hono": "^2.0.14",
    "ai": "^7.0.163",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "~11.28.9",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.3",
      "onFail": "download"
    }
  }
}